# Copy this file to .env and fill in the values.

# Server
PORT=5000
NODE_ENV=production
# Where the website runs (allowed to call the API). Comma-separate several.
CORS_ORIGIN=http://localhost:5173

# MySQL
# On Hostinger, use DB_HOST=localhost when the backend runs on the same hosting account.
# From your own computer, use the remote host (e.g. srv909.hstgr.io) and allow your IP under
# hPanel > Databases > Remote MySQL.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
# Every table name starts with this. Use a different prefix per site when sites share one database.
DB_TABLE_PREFIX=ramtha_
# Connections open at once. Hostinger's remote MySQL accepts only 1 from outside, so use 1 when the
# backend runs on your own computer; 10 is fine on the hosting itself (DB_HOST=localhost).
DB_CONNECTION_LIMIT=10

# Admin login
# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# First admin account, created by `npm run setup`.
ADMIN_EMAIL=admin@alramthaeng.com
ADMIN_PASSWORD=

# Images
# With FTP_HOST set, uploaded images go to FTP_DIR on that FTP account (over TLS) and are
# served from MEDIA_URL, the public web address of FTP_DIR. Without it they are kept in backend/uploads.
# On Hostinger, use the server name (e.g. srv909.hstgr.io) so the TLS certificate matches.
FTP_HOST=
FTP_PORT=21
FTP_USER=
FTP_PASSWORD=
FTP_DIR=/alramtha_media
MEDIA_URL=https://your-domain.com/alramtha_media
